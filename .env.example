# NDRF Real-Time Disaster Ingestion Pipeline Environment Variables

# Backend Server Port (default 3001)
PORT=3001

# --- FREE / LEGITIMATE KEYED SOURCES ---
# (Note: USGS, NASA EONET, GDACS, ReliefWeb, Mastodon, Bluesky & RSS require NO keys!)

# 1. Reddit API (OAuth App Credentials)
# Register at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT="ndrf-disaster-aggregator:v1.0 (by /u/yourusername)"

# 2. NewsAPI.org (Free Developer Key)
# Register at https://newsapi.org/register
NEWSAPI_KEY=

# 3. GNews.io (Free Developer Key)
# Register at https://gnews.io/
GNEWS_KEY=
