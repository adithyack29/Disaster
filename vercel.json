{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/reports.ts": {
      "maxDuration": 60
    },
    "api/situation-brief.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
